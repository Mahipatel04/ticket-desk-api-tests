{
  "info": {
    "_postman_id": "bb8c48b6-60f8-4ff2-89a1-7e6600000001",
    "name": "Ticket Desk API - Regression Checks",
    "description": "Regression checks for authentication, ticket search, CRUD and dashboard totals.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Reject invalid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('invalid credentials return 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"wrong-password-for-test\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Sign in with demo account",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeds', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('JWT and display name are returned', () => { pm.expect(body.token).to.be.a('string').and.not.empty; pm.expect(body.name).to.eql('Demo Admin'); });",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{email}}\",\"password\":\"{{password}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Ticket workflows",
      "item": [
        {
          "name": "List tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('list returns 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('response is an array', () => pm.expect(rows).to.be.an('array'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Filter tickets by status",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status filter returns 200', () => pm.response.to.have.status(200));",
                  "const rows = pm.response.json();",
                  "pm.test('all results are Open', () => rows.forEach(ticket => pm.expect(ticket.status).to.eql('Open')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets?status=Open"
          }
        },
        {
          "name": "Create a ticket",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('createdTitle', 'API test ticket ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('create returns 201', () => pm.response.to.have.status(201));",
                  "const ticket = pm.response.json();",
                  "pm.test('new ticket is open', () => { pm.expect(ticket.id).to.be.a('number'); pm.expect(ticket.title).to.eql(pm.collectionVariables.get('createdTitle')); pm.expect(ticket.status).to.eql('Open'); });",
                  "pm.collectionVariables.set('ticketId', ticket.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\":\"{{createdTitle}}\",\"description\":\"Created by API regression checks.\",\"category\":\"Software\",\"priority\":\"High\",\"status\":\"Open\",\"requester\":\"API Test Runner\",\"assignee\":\"QA Analyst\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tickets"
          }
        },
        {
          "name": "Update status and assignment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('update returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"id\":{{ticketId}},\"title\":\"{{createdTitle}}\",\"description\":\"Updated by API regression checks.\",\"category\":\"Software\",\"priority\":\"Critical\",\"status\":\"In Progress\",\"requester\":\"API Test Runner\",\"assignee\":\"QA Analyst\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Read dashboard summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('dashboard returns 200', () => pm.response.to.have.status(200));",
                  "const summary = pm.response.json();",
                  "pm.test('dashboard counts are numeric', () => ['total','open','inProgress','resolved','critical'].forEach(key => pm.expect(summary[key], key).to.be.a('number').and.at.least(0)));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets/dashboard"
          }
        },
        {
          "name": "Delete created ticket",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('delete returns 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tickets/{{ticketId}}"
          }
        },
        {
          "name": "Verify deleted ticket is absent",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rows = pm.response.json();",
                  "pm.test('deleted ticket is absent', () => { pm.response.to.have.status(200); pm.expect(rows.some(ticket => ticket.id === Number(pm.collectionVariables.get('ticketId')))).to.eql(false); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tickets"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "ticketId",
      "value": ""
    },
    {
      "key": "createdTitle",
      "value": ""
    }
  ]
}
